{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --prefix website",
  "outputDirectory": "website/dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/voices", "destination": "/voices.html" },
    { "source": "/motion", "destination": "/motion.html" }
  ]
}
